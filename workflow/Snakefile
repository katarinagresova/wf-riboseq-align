# Ribo-seq fastq -> transcriptome-aligned BAM, split into human / spike-in.
# Runs standalone or as a module.

configfile: "config/config.yaml"

include: "rules/common.smk"
include: "rules/trim.smk"
include: "rules/contaminants.smk"
include: "rules/align.smk"
include: "rules/qc.smk"
include: "rules/fastqc.smk"
include: "rules/multiqc.smk"


rule all:
    input:
        [
            [
                experiment_files(f"{EXP_DIR}/split_bam/transcriptome/{{species}}/{{sample}}.bam.bai", e, "ribo",
                                 species=["human", "spike_in"]),
                expand(f"{EXP_DIR}/qc/summary.tsv", **({} if e is None else {"experiment": e})),
                expand(f"{EXP_DIR}/multiqc/multiqc_report.html", **({} if e is None else {"experiment": e})),
                experiment_files(f"{EXP_DIR}/fastqc/{{stage}}/{{sample}}_fastqc.html", e, "ribo",
                                 stage=["ribo_raw", "ribo_trimmed"]),
            ]
            for e in EXPERIMENTS
        ],
